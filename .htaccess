
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # No modificar archivos ni directorios existentes
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Redirigir las rutas de Angular a index.html
    RewriteRule ^ index.html [L]
</IfModule>
